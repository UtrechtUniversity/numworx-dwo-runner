<?xml version="1.0" encoding="UTF-8"?>
<launch4jConfig>
  <dontWrapJar>false</dontWrapJar>
  <headerType>gui</headerType>
  <jar>..\output\jar\accuu\dwo_runner_accuu.jar</jar>
  <outfile>..\output\exe\start-accuu.exe</outfile>
  <errTitle></errTitle>
  <cmdLine></cmdLine>
  <chdir>.</chdir>
  <priority>normal</priority>
  <downloadUrl>http://java.com/download</downloadUrl>
  <supportUrl></supportUrl>
  <stayAlive>false</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  <manifest></manifest>
  <icon>..\output\jar\favicon.ico</icon>
  <singleInstance>
    <mutexName>DWO</mutexName>
    <windowTitle></windowTitle>
  </singleInstance>
  <classPath>
    <mainClass>fi.dwo_runner.DWO_runner</mainClass>
    <cp>lib/jxbrowser-7.8.jar</cp>
    <cp>lib/jxbrowser-swing-7.8.jar</cp>
    <cp>lib/jxbrowser-win32-7.8.jar</cp>
    <cp>lib/jxbrowser-win64-7.8.jar</cp>
  </classPath>
  <jre>
    <path>jre</path>
    <bundledJre64Bit>true</bundledJre64Bit>
    <bundledJreAsFallback>false</bundledJreAsFallback>
    <minVersion></minVersion>
    <maxVersion></maxVersion>
    <jdkPreference>preferJre</jdkPreference>
    <runtimeBits>64/32</runtimeBits>
    <initialHeapSize>512</initialHeapSize>
    <maxHeapSize>2048</maxHeapSize>
  </jre>
  <splash>
    <file>..\output\jar\splash.bmp</file>
    <waitForWindow>true</waitForWindow>
    <timeout>60</timeout>
    <timeoutErr>true</timeoutErr>
  </splash>
</launch4jConfig>