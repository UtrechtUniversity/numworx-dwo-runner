-classpath: jxbrowser-linux64-7.13.jar
Bundle-SymbolicName: com.teamdev.jxbrowser.linux
ver: 7.13
-output: ${bsn}-${ver}.jar
Bundle-Version: ${ver}
Fragment-Host: com.teamdev.jxbrowser;bundle-version=${ver}
Private-Package: *
Require-Capability: osgi.native;filter:="(&(osgi.native.osname~=linux)(osgi.native.processor~=x86-64))"
