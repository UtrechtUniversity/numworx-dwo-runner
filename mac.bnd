ver: 7.28.1
-classpath: target/jxbrowser-mac-${ver}.jar
Bundle-SymbolicName: com.teamdev.jxbrowser-mac
-output: target/${bsn}-${ver}.jar
Bundle-Version: ${ver}
Fragment-Host: com.teamdev.jxbrowser;bundle-version="[${ver},${ver}]"
Private-Package: *
Require-Capability: osgi.native;filter:="(&(osgi.native.osname~=macosx)(osgi.native.processor~=x86-64))"
Provide-Capability: com.teamdev.jxbrowser;platform="mac"
