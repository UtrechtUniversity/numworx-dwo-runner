-classpath: jxbrowser-mac-7.13.jar
Bundle-SymbolicName: com.teamdev.jxbrowser.mac
ver: 7.13
-output: ${bsn}-${ver}.jar
Bundle-Version: ${ver}
Fragment-Host: com.teamdev.jxbrowser;bundle-version=${ver}
Private-Package: *
Require-Capability: osgi.native;filter:="(&(osgi.native.osname~=macosx)(osgi.native.processor~=x86-64))"
