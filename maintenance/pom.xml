<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>nl.uu.fi.dwo</groupId>
    <artifactId>runner-parent</artifactId>
    <version>3.0.1-SNAPSHOT</version>
  </parent>
  <groupId>nl.numworx.dwo.maintenance</groupId>
  <artifactId>maintenance</artifactId>
  <dependencies>
  	<dependency>
  		<groupId>junit</groupId>
  		<artifactId>junit</artifactId>
  		<version>4.12</version>
  		<scope>test</scope>
  	</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.rest</groupId>
  		<artifactId>dwo-jclient-lib</artifactId>
  	</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo</groupId>
  		<artifactId>dwo-commons-lib</artifactId>
  	</dependency>
  </dependencies>
  <properties>
  	<maven.compiler.source>1.8</maven.compiler.source>
  	<maven.compiler.target>1.8</maven.compiler.target>
  	<server.url>https://teuniz.dwo.nl/dwo/</server.url>
  </properties>
  <build>
  	<plugins>
		<plugin>
			<artifactId>maven-jar-plugin</artifactId>
			<version>2.4</version>
			<configuration>
				<archive>
					<manifest>
						<mainClass>nl.numworx.dwo.maintenance.Maintenance</mainClass>
						<addClasspath>true</addClasspath>
						<useUniqueVersions>false</useUniqueVersions>
					</manifest>
				</archive>
			</configuration>
		</plugin>
  	    <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>1.6.0</version>
        <executions>
          <execution>
            <goals>
              <goal>java</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
        <configuration>
          <mainClass>nl.numworx.dwo.maintenance.Maintenance</mainClass>
          <systemProperties>
            <systemProperty>
              <key>maintenance.url</key>
              <value>${server.url}</value>
            </systemProperty>
            <systemProperty>
              <key>maintenance.user</key>
              <value>${user}</value>
            </systemProperty>
            <systemProperty>
              <key>maintenance.pass</key>
              <value>${pass}</value>
            </systemProperty>
          </systemProperties>
        </configuration>
      </plugin>
   	  <plugin>
        <groupId>external.atlassian.jgitflow</groupId>
        <artifactId>jgitflow-maven-plugin</artifactId>
        <version>1.0-m5.1</version>
      </plugin>
  	</plugins>
  </build>
  <profiles>
  	<profile>
  		<id>test</id>
  		<properties>
			<user>gcadmin</user>
  			<server.url>https://test.dwo.nl/dwo/</server.url>
  		</properties>
  	</profile>
  	<profile>
  		<id>app</id>
  		<properties>
			<user>gcadmin</user>
   			<server.url>https://app.dwo.nl/dwo/</server.url>
   		</properties>
  	</profile>
  	<profile>
  		<id>release</id>
		<activation>
			<property><name>performRelease</name></property>
		</activation>
  		<properties>
  			<exec.skip>true</exec.skip>
  		</properties>
  	</profile>
        <profile>
                <id>github</id>
                <properties>
                        <exec.skip>true</exec.skip>
                </properties>
        </profile>
                <profile>
                <id>localhost</id>
                <properties>
                        <exec.skip>true</exec.skip>
                        <user>dwoadmin</user>
                        <pass>dwoadmin</pass>
   						<server.url>http://localhost:8080/dwo/</server.url>
                </properties>
        </profile>
  </profiles>
  <version>3.0.1-SNAPSHOT</version>
</project>
