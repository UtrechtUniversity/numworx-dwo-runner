<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Adjust artifact, name and description for new projects -->
	<parent>
		<groupId>nl.uu.fi.dwo</groupId>
		<artifactId>DWO</artifactId>
		<version>2.5.19</version>
	</parent>
	<!-- Adjust artifact, name and description for new projects -->
	<artifactId>DWOJApplet-Starter</artifactId>
	<name>DWOJApplet - Starter</name>
	<url>http://www.dwo.nl</url>
	<packaging>jar</packaging>
	<!-- Update year to current when starting a new project -->
	<inceptionYear>2015</inceptionYear>
	<organization>
		<name>Freudenthal Institute</name>
		<url>http://www.uu.nl/onderzoek/freudenthal-instituut</url>
	</organization>

	<developers>
		<developer>
			<id>Wim van Velthoven</id>
			<name>velth101</name>
			<email>w.p.g.vanvelthoven@uu.nl</email>
			<organization>Freudenthal Institute</organization>
			<organizationUrl>http://www.uu.nl/onderzoek/freudenthal-instituut</organizationUrl>
			<roles>
				<role>Java Developer</role>
			</roles>
		</developer>
	</developers>

	<!-- update the https path for a different branch or tag! -->
	<scm>
		<developerConnection>scm:svn:https://svn.science.uu.nl/repos/sci.velth101.projects/DWOJApplet-Starter/trunk</developerConnection>
	</scm>

	<!-- dependencies -->

	<build>
		<!-- order is relevant -->
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.2</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
					<executable>${jdk}/bin/javac</executable>
					<fork>false</fork>
					<encoding>${project.build.sourceEncoding}</encoding>
					<showDeprecation>true</showDeprecation>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>2.18.1</version>
				<configuration>
					<skipTests>true</skipTests>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.felix</groupId>
				<artifactId>maven-bundle-plugin</artifactId>
				<executions>
					<execution>
						<id>bundle-manifest</id>
						<goals><goal>manifest</goal></goals>
						<phase>process-classes</phase>
					</execution>
				</executions>
				<configuration>
					<instructions>
							<_snapshot>${osgi.qualifier}</_snapshot>
							<Bundle-SymbolicName>fi.dwo.dwojapplet</Bundle-SymbolicName>
							<Bundle-Name>DWO v2 bootstrap</Bundle-Name>
							<Bundle-ManifestVersion>2</Bundle-ManifestVersion>
							<Bundle-Activator>fi.dwo.dwojapplet.boot.Starter</Bundle-Activator>
							<Import-Package>fi.dwo.eawt;version="[1,2)";resolution:=optional,fi.dwo.bootloader;resolution:=optional,org.osgi.framework,org.osgi.service.event;version="[1.3,2)",org.osgi.service.cm;version="[1.5,2)",org.osgi.util.tracker;version="[1.5,2)",com.apple.eawt;resolution:=optional,javax.imageio,javax.swing,javax.swing.border,javax.swing.event,javax.swing.filechooser,javax.swing.plaf,javax.swing.plaf.basic,javax.swing.plaf.metal,javax.swing.table,javax.swing.text,javax.swing.text.html,javax.swing.tree,org.knopflerfish.service.repository;version="[1.0,2)";resolution:=optional,org.apache.felix.bundlerepository;version="[2.1,3)";resolution:=optional,org.osgi.service.log;version="[1.3,2)",org.w3c.dom,javax.xml.parsers,javax.xml.transform,javax.xml.transform.dom,javax.xml.transform.stream,org.xml.sax,org.osgi.service.provisioning;resolution:=optional,org.osgi.util.promise;version="[1,2)",org.osgi.util.function;version="[1,2)",javax.xml.bind.annotation</Import-Package>
							<Export-Package>fi.beans.copyright,fi.beans.loader,fi.beans.scorm,fi.beans.xmlrpc,fi.beans.mainframe</Export-Package>
							<Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=1.8))"</Require-Capability>
					</instructions>				
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>2.5</version>
				<configuration>
					<archive>
					    <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
							<addClasspath>false</addClasspath>
						</manifest>
						<manifestEntries>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>2.5.3</version>
                <configuration>
                    <tagBase>https://svn.science.uu.nl/repos/sci.velth101.projects/DWOJApplet-Starter/tags/</tagBase>
                </configuration>            
            </plugin>            
		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>nl.uu.fi.dwo</groupId>
			<artifactId>DWOJClient</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>org.osgi.core</artifactId>
			<version>5.0.0</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>fi.dwo</groupId>
			<artifactId>BootLoader</artifactId>
			<version>2.0.6</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>org.osgi.service.event</artifactId>
			<version>1.3.1</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>org.osgi.service.cm</artifactId>
			<version>1.5.0</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.felix</groupId>
			<artifactId>org.apache.felix.bundlerepository</artifactId>
			<version>2.0.10</version>
			<optional>true</optional>
			<scope>provided</scope>
		</dependency>
		<dependency>
		  	<groupId>org.knopflerfish.kf6.bundle.repository</groupId>
	  		<artifactId>xml-API</artifactId>
	  		<version>1.1.0</version>
	  		<scope>provided</scope>
	  		<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>org.osgi.service.log</artifactId>
			<version>1.3.0</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>org.osgi.service.provisioning</artifactId>
			<version>1.2.0</version>
		</dependency>
	</dependencies>
	<version>2.0.3-SNAPSHOT</version>
	<groupId>fi.dwo</groupId>
	<properties>
		<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
		<osgi.qualifier>${maven.build.timestamp}</osgi.qualifier>
	</properties>
	<repositories>
	    <repository>
	      <id>Knopflerfish 6 Repository</id>
	      <name>Knopflerfish 6 Releases Repository</name>
	      <url>https://resources.knopflerfish.org/repo/maven2/release</url> 
	    </repository>
	  </repositories>
  </project>
