<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>fi.dwo</groupId>
  <artifactId>unpack200</artifactId>
  <version>2.5.49-SNAPSHOT</version>
  <name>UnPack200</name>
  <description>StreamHandler voor pack200 jars</description>
	<properties>
		<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
		<osgi.qualifier>${maven.build.timestamp}</osgi.qualifier>
		<maven.compiler.source>11</maven.compiler.source>
		<maven.compiler.target>11</maven.compiler.target>
	</properties>
  <dependencies>
  	<dependency>
  		<groupId>org.osgi</groupId>
  		<artifactId>org.osgi.core</artifactId>
  		<version>5.0.0</version>
  		<scope>provided</scope>
  	</dependency>
  </dependencies>
  <build>
  	<plugins>
  	  <plugin>
    	<groupId>org.apache.maven.plugins</groupId>
    	<artifactId>maven-toolchains-plugin</artifactId>
    	<version>3.1.0</version>
    <executions>
      <execution>
        <goals>
          <goal>toolchain</goal>
        </goals>
      </execution>
    </executions>
    <configuration>
      <toolchains>
        <jdk>
          <version>11</version>
        </jdk>
      </toolchains>
    </configuration>
  	  </plugin>
  	  <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <version>5.1.1</version>
        <extensions>true</extensions>
        <configuration>
          <instructions>
				<_snapshot>${osgi.qualifier}</_snapshot>
				<Bundle-Activator>fi.dwo.unpack200.Activator</Bundle-Activator>
				<Private-Package>fi.dwo.unpack200</Private-Package>
				<Export-Package />
				<Import-Package>java.util.jar;*</Import-Package>
          </instructions>
        </configuration>
      </plugin>
 	</plugins>  
  </build>
  <packaging>bundle</packaging>
  <parent>
          <groupId>nl.uu.fi.dwo</groupId>
          <artifactId>runner-parent</artifactId>
          <version>2.5.49-SNAPSHOT</version>
          <relativePath>../..</relativePath>
  </parent>
</project>
