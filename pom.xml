<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
	<parent>
        <groupId>nl.uu.fi.dwo</groupId>
        <artifactId>dwo</artifactId>
        <version>2.5.49-SNAPSHOT</version>
	</parent>
  <artifactId>runner-parent</artifactId>
  <version>2.5.49-SNAPSHOT</version>
  <packaging>pom</packaging>
  <properties>
	<dwo.version>2.5.49-SNAPSHOT</dwo.version>
  </properties>
  <modules>
	<module>osgi-jxbrowser-bundles</module>
	<module>osgi</module>
	<module>DWO_runner</module>
	<module>maintenance</module>
	<module>DWOOffline</module>
	<module>initdb</module>
  </modules>
    <build>
        <plugins>
    		<plugin>
            	<groupId>external.atlassian.jgitflow</groupId>
            	<artifactId>jgitflow-maven-plugin</artifactId>
            	<version>1.0-m5.1</version>
            	<configuration>
                	<!-- see goals wiki page for configuration options -->
                	<flowInitContext>
             			<developBranchName>develop</developBranchName>  
             			<masterBranchName>main</masterBranchName>    	
                	</flowInitContext>
                	<localOnly>true</localOnly>
                	<allowSnapshots>false</allowSnapshots>
                	<enableSshAgent>true</enableSshAgent>
                	<noDeploy>true</noDeploy>
                	<autoVersionSubmodules>true</autoVersionSubmodules>
            	</configuration>
			  <dependencies>
			    <dependency>
			      <groupId>com.jcraft</groupId>
			      <artifactId>jsch</artifactId>
			      <version>0.1.54</version>
			    </dependency>
				<dependency>
				  <groupId>net.java.dev.jna</groupId>
				  <artifactId>jna-platform</artifactId>
				  <version>5.12.1</version>
				</dependency>
			  </dependencies>
        	</plugin>
         </plugins>
  </build>
  <repositories>
    <repository>
	<id>numworx-dwo-project</id>
	<url>https://maven.pkg.github.com/UtrechtUniversity/numworx-dwo-project</url>
	<snapshots><enabled>true</enabled></snapshots>
    </repository>
    <repository>
	<id>numworx-dwo-runner</id>
	<url>https://maven.pkg.github.com/UtrechtUniversity/numworx-dwo-runner</url>
	<snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>
    <distributionManagement>
	    <repository>
	      <id>github</id>
	      <name>GitHub Packages</name>
	      <url>https://maven.pkg.github.com/UtrechtUniversity/numworx-dwo-runner</url>
	    </repository>
        <snapshotRepository>
          <id>github</id>
          <name>GitHub Packages</name>
          <url>https://maven.pkg.github.com/UtrechtUniversity/numworx-dwo-runner</url>
        </snapshotRepository>
    </distributionManagement>
</project>
