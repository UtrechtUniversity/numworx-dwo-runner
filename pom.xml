<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>fi.dwo</groupId>
  <artifactId>unpack200</artifactId>
  <version>0.0.2-SNAPSHOT</version>
  <name>UnPack200</name>
  <description>StreamHandler voor pack200 jars</description>
	<properties>
		<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
		<osgi.qualifier>${maven.build.timestamp}</osgi.qualifier>
	</properties>
  <dependencies>
  	<dependency>
  		<groupId>org.osgi</groupId>
  		<artifactId>org.osgi.core</artifactId>
  		<version>5.0.0</version>
  		<scope>provided</scope>
  	</dependency>
  </dependencies>
  <build>
  	<plugins>
  	  <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <version>2.5.3</version>
        <extensions>true</extensions>
        <configuration>
          <instructions>
				<_snapshot>${osgi.qualifier}</_snapshot>
				<Bundle-Activator>fi.dwo.unpack200.Activator</Bundle-Activator>
				<Private-Package>fi.dwo.unpack200</Private-Package>
				<Export-Package></Export-Package>
          </instructions>
        </configuration>
      </plugin>
      <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-release-plugin</artifactId>
          <version>2.5.3</version>
      </plugin>
  	</plugins>  
  </build>
  <packaging>bundle</packaging>
  <parent>
  	<groupId>nl.uu.fi.dwo</groupId>
  	<artifactId>DWO.master.pom</artifactId>
  	<version>1.1</version>
  </parent>
  <scm>
  	<developerConnection>scm:svn:https://svn.science.uu.nl/repos/sci.velth101.projects/unpack200/trunk</developerConnection>
  </scm>
</project>