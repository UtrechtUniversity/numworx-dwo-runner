-classpath: jxbrowser-swing-7.13.jar
Bundle-SymbolicName: com.teamdev.jxbrowser.swing
ver: 7.13
-output: ${bsn}-${ver}.jar
Bundle-Version: ${ver}
Export-Package: *;version=${ver}
