ver: 7.28.1
-classpath: target/jxbrowser-swing-${ver}.jar
Bundle-SymbolicName: com.teamdev.jxbrowser-swing
-output: target/com.teamdev.jxbrowser-swing-${ver}.jar
Bundle-Version: ${ver}
Export-Package: *;version=${ver}
