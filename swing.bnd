ver: 7.28.1
-classpath: jxbrowser-swing-${ver}.jar
Bundle-SymbolicName: com.teamdev.jxbrowser.swing
-output: ${bsn}-${ver}.jar
Bundle-Version: ${ver}
Export-Package: *;version=${ver}
Import-Package: com.teamdev.jxbrowser.*;version="[${ver},${ver}]",sun.awt.*;resolution:=optional,javax.annotation;resolution:=optional,*
