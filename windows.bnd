ver: 7.28.1
-classpath: target/jxbrowser-win64-${ver}.jar
Bundle-SymbolicName: com.teamdev.jxbrowser.win64
-output: target/${bsn}-${ver}.jar
Bundle-Version: ${ver}
Fragment-Host: com.teamdev.jxbrowser;bundle-version="[${ver},${ver}]"
Private-Package: *
Require-Capability: osgi.native;filter:="(&(osgi.native.osname~=win32)(osgi.native.processor~=x86-64))"
Provide-Capability: com.teamdev.jxbrowser;platform="windows"
